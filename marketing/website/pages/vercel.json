{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.traart.ru"
        }
      ],
      "destination": "https://traart.ru/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.traart.ru"
        }
      ],
      "destination": "https://traart.ru/:path*",
      "permanent": true
    },
    {
      "source": "/use-case-coaches",
      "destination": "/use-cases#coaching",
      "permanent": true
    },
    {
      "source": "/use-case-developers",
      "destination": "/use-cases#dev",
      "permanent": true
    },
    {
      "source": "/use-case-hr",
      "destination": "/use-cases#hr",
      "permanent": true
    },
    {
      "source": "/use-case-marketers",
      "destination": "/use-cases#marketing",
      "permanent": true
    },
    {
      "source": "/use-case-product-managers",
      "destination": "/use-cases#product",
      "permanent": true
    },
    {
      "source": "/use-case-realtors",
      "destination": "/use-cases#realty",
      "permanent": true
    },
    {
      "source": "/use-case-researchers",
      "destination": "/use-cases#research",
      "permanent": true
    },
    {
      "source": "/use-case-vibecoders",
      "destination": "/use-cases#ai-coding",
      "permanent": true
    },
    {
      "source": "/use-cases/business",
      "destination": "/use-cases#business",
      "permanent": true
    },
    {
      "source": "/use-cases/journalists",
      "destination": "/use-cases#journalists",
      "permanent": true
    },
    {
      "source": "/use-cases/lawyers",
      "destination": "/use-cases#legal",
      "permanent": true
    },
    {
      "source": "/use-cases/lectures",
      "destination": "/use-cases#lectures",
      "permanent": true
    },
    {
      "source": "/use-cases/medical",
      "destination": "/use-cases#medical",
      "permanent": true
    },
    {
      "source": "/use-cases/podcasters",
      "destination": "/use-cases#podcast",
      "permanent": true
    },
    {
      "source": "/use-cases/students",
      "destination": "/use-cases#students",
      "permanent": true
    },
    {
      "source": "/use-cases/content-creators",
      "destination": "/video",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://yastatic.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; img-src 'self' data: https://mc.yandex.ru https://mc.yandex.com https://mc.yandex.by https://mc.yandex.kz https://mc.yandex.com.tr https://mc.webvisor.org https://mc.webvisor.com https://yastatic.net; font-src 'self' data:; connect-src 'self' wss://mc.yandex.ru wss://mc.yandex.com wss://mc.webvisor.org wss://mc.webvisor.com https://mc.yandex.ru https://mc.yandex.com https://mc.yandex.by https://mc.yandex.kz https://mc.yandex.com.tr https://mc.webvisor.org https://mc.webvisor.com https://yastatic.net; frame-src https://mc.yandex.ru https://mc.yandex.com; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}